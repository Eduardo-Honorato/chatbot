# Environment variables for Chatbot Backend

# Flask configuration
SECRET_KEY=your-secret-key-here
FLASK_DEBUG=True

# LLM API Keys (Free Tier - get from provider consoles)
# OpenAI: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic: https://www.anthropic.com/account
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-instant-1.2

# Google Gemini: httpsmakersuite.google.com/app
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

# DATABASE_URL - Supabase Transaction Pooler (porta 6543)
# Formato: postgresql://postgres:PASSWORD@db.seu-projeto.supabase.co:6542/postgres
# Substitua PASSWORD pela sua senha do Supabase
# DATABASE_URL=postgresql://postgres:your-password-here@db.seu-projeto.supabase.co:6542/postgres

# Application settings
SESSION_TIMEOUT=3600
MAX_MESSAGE_LENGTH=10000